{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argdata.ar/schemas/content-package.schema.json",
  "title": "ARG Data Content Package",
  "type": "object",
  "required": ["claim_id", "claim", "status", "verdict", "confidence", "evidence", "sources", "editorial_gate"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^ARG-[0-9]{6}$"},
    "claim": {"type": "string", "minLength": 1},
    "status": {"enum": ["DISCOVERED", "RESEARCHING", "READY_FOR_REVIEW", "APPROVED", "REJECTED", "PUBLISHED"]},
    "verdict": {"enum": ["TRUE", "MOSTLY_TRUE", "MISLEADING", "MOSTLY_FALSE", "FALSE", "UNVERIFIABLE"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "risk_flags": {"type": "array", "items": {"type": "string"}},
    "content": {
      "type": "object",
      "properties": {
        "hook": {"type": "string"},
        "x_post": {"type": "string"},
        "x_thread": {"type": "array", "items": {"type": "string"}},
        "short_script": {"type": "string"},
        "youtube_script": {"type": "string"},
        "title_candidates": {"type": "array", "items": {"type": "string"}},
        "thumbnail_concept": {"type": "string"},
        "chart_specs": {"type": "array", "items": {"type": "object"}}
      }
    },
    "editorial_gate": {
      "type": "object",
      "required": ["human_review_required"],
      "properties": {
        "human_review_required": {"const": true},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["institution", "url", "retrieved_at", "source_type"],
      "properties": {
        "institution": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "source_type": {"enum": ["PRIMARY", "SECONDARY", "METHODOLOGY"]},
        "dataset": {"type": ["string", "null"]},
        "series_id": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "statement", "source_ref"],
      "properties": {
        "id": {"type": "string"},
        "statement": {"type": "string"},
        "source_ref": {"type": "integer", "minimum": 0},
        "period": {"type": ["string", "null"]},
        "value": {"type": ["number", "string", "null"]},
        "unit": {"type": ["string", "null"]},
        "transformation": {"type": ["string", "null"]},
        "supports": {"enum": ["SUPPORTS", "CONTRADICTS", "CONTEXT"]}
      }
    }
  }
}
